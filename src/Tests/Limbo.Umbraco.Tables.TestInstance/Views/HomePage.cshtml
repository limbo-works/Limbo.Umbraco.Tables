@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Limbo.Umbraco.Tables.Models;
@{
	Layout = null;
	var table = Model.Value<TableModel>("tableBuilder");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Name</title>
</head>
<body>
    @if (table is not null)
    {
        @table
    }
</body>
</html>